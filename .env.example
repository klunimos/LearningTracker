# Copy this file to ".env" and fill in real values. Do NOT commit ".env".

# SQL Server "sa" password.
# Requirements: at least 8 chars, with uppercase, lowercase, digit and symbol.
SA_PASSWORD=Change_This_Strong#Passw0rd

# JWT signing key — at least 32 random characters.
# Generate one on the server with:  openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-at-least-32-characters

# SMTP settings for outgoing mail (password reset emails).
# Leave SMTP_HOST empty to disable real sending — the reset link is logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@chelkenu.org
SMTP_FROM_NAME=חלקנו
SMTP_ENABLE_SSL=true
